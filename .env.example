# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 환경변수가 필요한지"를 알려주는 명세다.
# 실제 값은 .env.local 에 넣는다. .env.local 은 git에 올라가지 않는다.
#
#   cp .env.example .env.local
#
# 값은 Supabase 대시보드 > Project Settings > API Keys 에서 확인한다.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=

# 공개 키. 브라우저에 노출되는 것이 정상이다.
# 이 키로 무엇을 할 수 있는지는 RLS 정책이 결정한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ 서버 전용. 절대 NEXT_PUBLIC_ 접두어를 붙이지 말 것.
# RLS를 전부 우회하는 키라 브라우저에 노출되면 DB 전체가 열린다.
# 사용처: 상담 신청 저장(src/lib/actions/consultation.ts). 비어 있으면 신청이 접수되지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오맵 JavaScript 키 (소개 페이지 지도)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ───── 선택: 새 상담 접수 이메일 알림 (셋 다 있어야 켜진다, 없으면 접수만 되고 알림 생략) ─────

# Resend API 키 (https://resend.com). 서버 전용.
RESEND_API_KEY=

# 알림을 받을 주소 (변호사 수신함)
CONSULTATION_NOTIFY_TO=

# 발신 주소. Resend 에 인증된 도메인이어야 한다 (테스트는 onboarding@resend.dev 가능)
CONSULTATION_NOTIFY_FROM=

# 사이트 기본 URL (메타태그·sitemap 생성용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───── 선택: 어드민 E2E (pnpm qa:admin) 전용. 없으면 테스트가 스킵된다 ─────

# 어드민 테스트 계정 (qa/README.md). 운영 계정을 쓰지 말 것.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=

# 테스트 대상 주소. 기본값 http://localhost:4000
# QA_BASE_URL=
